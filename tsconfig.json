{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"paths": {
			"~/*": ["./src/*"],
			"@pokemon-website/stores/*": ["./src/client/stores/*"],
			"@pokemon-website/types/*": ["./src/types/*"]
		}
	},
	"include": ["src/**/*", "scripts/**/*"],
	"exclude": ["node_modules", "public"]
}
