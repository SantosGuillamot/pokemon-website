{
  "name": "pokemon-website",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build:js": "node --import tsx/esm scripts/build.ts",
    "build:js:watch": "node --import tsx/esm scripts/build.ts --watch",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "build:css": "tailwindcss -i src/styles/input.css -o public/css/app.css --minify",
    "build:css:watch": "tailwindcss -i src/styles/input.css -o public/css/app.css --watch",
    "dev": "node --watch --import tsx/esm src/server.ts",
    "start": "node src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "hono": "^4.12.8"
  }
}
